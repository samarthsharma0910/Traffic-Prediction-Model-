# Copy this file to ".env" and fill in your own values. ".env" is git-ignored - never commit real keys.

# Optional: TomTom API key for real measured traffic and the live traffic layer
# (free key: https://developer.tomtom.com). Leave empty to run on ML estimates only.
TOMTOM_API_KEY=

# Optional tuning
# TOMTOM_DAILY_BUDGET=2200
# PORT=8000
# HOST=127.0.0.1
